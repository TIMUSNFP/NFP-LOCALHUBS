PORT=4100

# Same Supabase Postgres pooler connection string as the main NFP Circles
# backend (backend/.env) — this app reuses that database, just its own
# poll_-prefixed tables. Copy the value from backend/.env.
DATABASE_URL=

# Must match the main NFP Circles admin credentials exactly (backend/.env) —
# the poll host console reuses that login rather than a separate password.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Base URL of the main NFP Circles API, used to fetch the Approved Circle
# Leaders list for the participant join dropdown.
MAIN_API_BASE=https://nfp-circles.vercel.app

# Comma-separated list of allowed CORS origins for production. Leave empty
# during local development to reflect any origin.
ALLOWED_ORIGINS=
